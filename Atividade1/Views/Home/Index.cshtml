@model AtividadeBiblioteca.Models.HomeViewModel

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Página Inicial</title>
    <style>
        body {
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .container {
            background: white;
        }
        h1 { color: #333; }
        p { color: #666; }
        .btn:hover { background-color: #0056b3; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Livros Disponíveis</h1>
        <p>Confira nossa seleção de livros disponíveis para empréstimo.</p>
        <p>@Model.LivrosDisponiveis</p>
        <a asp-action="Sobre" class="btn">Saiba Mais</a>
    </div>
</body>
</html>